# Sao chép thành .env để ghi đè config.yaml (dùng cho cả ./run.sh lẫn docker compose)
# DOCQA_LLM_MODEL=qwen2.5:7b
# DOCQA_PORT=8000
# DOCQA_MIN_SIMILARITY=0.35

# Tài khoản đăng nhập khi mở ra internet (docker compose --profile public, Caddy basic auth).
# Tạo mã băm mật khẩu:
#   docker run --rm caddy:2.10.2 caddy hash-password --plaintext 'mat-khau-cua-cau'
# Dán kết quả vào DOCQA_AUTH_HASH, GIỮ NGUYÊN dấu nháy đơn (vì mã băm có ký tự $).
# DOCQA_AUTH_USER=team
# DOCQA_AUTH_HASH='$2a$14$...'
# DOCQA_PUBLIC_PORT=8080      # cổng Caddy trên máy, Tailscale Funnel trỏ vào cổng này
